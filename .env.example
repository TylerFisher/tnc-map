# Copy to `.env` and fill in. Only `npm run sync` reads these — nothing here
# reaches the browser, and none of it is secret.

# Published Google Sheet CSV URL.
# In the Sheet: File > Share > Publish to web > choose the sheet > Comma-separated values (.csv)
# Leave unset to build from the checked-in data/members.csv instead.
SHEET_CSV_URL=

# Sent to OpenStreetMap's Nominatim geocoder, whose usage policy asks for an
# identifying User-Agent with a contact route. Change the contact detail to
# whoever should be emailed if the geocoding traffic ever causes a problem.
GEOCODER_USER_AGENT=tnc-member-map/1.0 (Tiny News Collective; https://www.tinynewsco.org/)
